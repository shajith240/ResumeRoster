    },
    "display": {
      "$value": "Instrument Serif",
      "$type": "fontFamily",
      "$description": "Editorial display font for landing and brand moments."
    }
  },
  "typography": {
    "caption": {
      "$value": {
        "fontFamily": "Reddit Sans",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.5
      },
      "$type": "typography"
    },
    "label": {
      "$value": {
        "fontFamily": "Reddit Sans",
