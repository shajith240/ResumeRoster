  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "6px", "$type": "dimension" },
    "md": { "$value": "10px", "$type": "dimension" },
    "lg": { "$value": "14px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgba(23, 19, 15, 0.06), 0 1px 0 rgba(255, 255, 255, 0.7) inset",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 8px 24px rgba(23, 19, 15, 0.08), 0 1px 0 rgba(255, 255, 255, 0.72) inset",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 18px 44px rgba(23, 19, 15, 0.12)",
      "$type": "shadow"
    },
    "focus": {
      "$value": "0 0 0 3px rgba(232, 93, 38, 0.24)",
      "$type": "shadow"
    }
  },
  "$extensions": {
    "linted": {
      "version": "1.0.0",
      "principle": "Warm career debugging workspace with Reddit Sans, Instrument Serif, flat surfaces, and orange as signal."
    }
  }
}
