        "fontWeight": 400,
        "lineHeight": 1.12
      },
      "$type": "typography"
    },
    "page-heading": {
      "$value": {
        "fontFamily": "Instrument Serif",
        "fontSize": "44px",
        "fontWeight": 400,
        "lineHeight": 1.05
      },
      "$type": "typography"
    },
    "hero-display": {
      "$value": {
        "fontFamily": "Instrument Serif",
        "fontSize": "64px",
        "fontWeight": 400,
        "lineHeight": 0.98
      },
      "$type": "typography"
    }
