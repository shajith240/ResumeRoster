        "fontWeight": 400,
        "lineHeight": 1.55
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontFamily": "Reddit Sans",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.55
      },
      "$type": "typography"
    },
    "ui-title": {
      "$value": {
        "fontFamily": "Reddit Sans",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.35
      },
      "$type": "typography"
    },
    "section-heading": {
      "$value": {
        "fontFamily": "Instrument Serif",
