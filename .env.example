NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Razorpay — payments and refunds
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron — protect /api/cron/* routes (generate a random secret, add to Vercel dashboard too)
CRON_SECRET=

# Error monitoring (Sentry — https://sentry.io)
# NEXT_PUBLIC_ prefix required so the browser SDK can read it
NEXT_PUBLIC_ERROR_MONITORING_DSN=
NEXT_PUBLIC_ERROR_MONITORING_ENVIRONMENT=development
NEXT_PUBLIC_ERROR_MONITORING_TRACES_SAMPLE_RATE=0.01
# Source map upload (optional but strongly recommended for production)
ERROR_MONITORING_URL=https://sentry.io/
ERROR_MONITORING_ORG=linted
ERROR_MONITORING_PROJECT=javascript-nextjs
ERROR_MONITORING_AUTH_TOKEN=

NEXT_PUBLIC_COMMUNITY_POSTS_ENABLED=true
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
PUSH_WEBHOOK_SECRET=
UPLOAD_MALWARE_SCAN_MODE=required
UPLOAD_MALWARE_SCAN_URL=
UPLOAD_MALWARE_SCAN_TOKEN=
UPLOAD_MALWARE_SCAN_TIMEOUT_MS=8000
