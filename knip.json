{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"app/**/*.{ts,tsx}",
		"components/**/*.{ts,tsx}",
		"instrumentation.ts",
		"instrumentation-client.ts",
		"next.config.ts",
		"playwright.config.ts",
		"scripts/**/*.mjs",
		"tests/browser/**/*.{ts,tsx}",
		"vitest.config.ts"
	],
	"project": [
		"app/**/*.{ts,tsx}",
		"components/**/*.{ts,tsx}",
		"lib/**/*.ts",
		"playwright.config.ts",
		"scripts/**/*.mjs",
		"tests/browser/**/*.{ts,tsx}",
		"*.{ts,mjs}"
	],
	"ignore": [
		"docs/generated/**",
		"public/assets/**",
		"supabase/.temp/**",
		"supabase/migrations/**"
	],
	"ignoreDependencies": [
		"@testing-library/jest-dom",
		"jscpd",
		"autoprefixer",
		"tailwindcss"
	]
}
